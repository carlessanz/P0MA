# Copia este archivo a .env.local y rellena los valores.
# .env.local está en .gitignore: nunca se sube al repositorio.

# Dashboard de Supabase -> Settings -> API Keys.
# Usar la NUEVA publishable key (sb_publishable_...), NO la anon key obsoleta.
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Accesos directos a las cuentas de prueba en /login (src/lib/accessosTest.ts).
# Son CONTRASEÑAS EN CLARO en el bundle del cliente: solo de organizaciones ficticias
# TEST-*, nunca del equipo. Ponerlo a false —o quitarlo— en cuanto la app deje de ser
# una demo; entonces el módulo entero se cae del bundle al compilar.
VITE_ACCESSOS_TEST=false
